{
  "topology": {
    "num_leaves": 2,
    "num_spines": 2,
    "nodes_per_leaf": 4,
    "gpus_per_node": 2,
    "gpu_memory_gib": 80.0,
    "nic_bandwidth_gbps": 200.0,
    "uplink_bandwidth_gbps": 400.0,
    "link_latency_us": 1.0,
    "routing": "ecmp",
    "placements": [
      {"instance_id": "p0", "role": "prefill", "gpu_ids": [0, 1, 2, 3]},
      {"instance_id": "d0", "role": "decode", "gpu_ids": [12, 13, 14, 15]},
      {"instance_id": "p1", "role": "prefill", "gpu_ids": [8, 9, 10, 11]},
      {"instance_id": "d1", "role": "decode", "gpu_ids": [4, 5, 6, 7]}
    ],
    "intra_node_bandwidth_gbps": 1600.0,
    "intra_node_latency_us": 0.5
  },
  "binding": {
    "policy": "round_robin",
    "joint_selection_enabled": false,
    "window_enabled": false,
    "prediction_enabled": false,
    "prediction_sample_every": 0,
    "wall_clock_diagnostics": false,
    "decision_overhead_us": 0.0
  },
  "kv_scheduler": {
    "policy": "ready_immediate",
    "slo_priority_enabled": false,
    "collective_protection_enabled": false,
    "inflight_budget_mode": "fixed",
    "pause_on_collective": false
  },
  "feedback": {
    "time_authority": "ns3",
    "network_backend": "ns3_alibabacloud",
    "compute_backend": "profiling",
    "compute_profile_path": "../backend/fixtures/compute_profile.json",
    "compute_profile_excludes_communication": true,
    "network_observation_enabled": false,
    "state_observation_enabled": false,
    "observation_delay_us": 0.0,
    "scheduling_overhead_us": 0.0
  },
  "reservations": {
    "reserve_max_output_tokens": 1024,
    "capacity_safety_fraction": 0.05,
    "shared_prefix_accounting": "physical_object",
    "source_release": "after_dependencies"
  },
  "evaluation": {
    "window_start_seconds": 0.0,
    "window_end_seconds": 0.1,
    "time_bin_seconds": 0.01,
    "default_ttft_slo_seconds": 0.02,
    "default_itl_slo_seconds": 0.005,
    "percentiles": [0.5, 0.95, 0.99],
    "output_dir": "../artifacts/evaluation",
    "plot_formats": ["png", "pdf"],
    "plot_dpi": 160,
    "charts": ["latency_cdf", "latency_percentiles", "slo_throughput", "throughput_timeseries"]
  },
  "prefix_cache": {
    "enabled": false,
    "prefill_reuse_enabled": false,
    "decode_reuse_enabled": false,
    "eviction_enabled": false
  },
  "recording": {
    "mode": "essential"
  },
  "runtime": {
    "seed": 7,
    "workload_path": "../backend/fixtures/workload.json",
    "time_limit_seconds": 0.1,
    "congestion_control": "dcqcn",
    "packet_payload_bytes": 1000,
    "switch_buffer_bytes": 16777216,
    "rpc_timeout_seconds": 60.0,
    "kv_transfer_mode": "whole_ready_immediate"
  }
}
