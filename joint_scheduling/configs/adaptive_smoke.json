  "binding": {
    "policy": "round_robin",
    "window_ms": 1.0,
    "early_trigger_margin_ms": 0.5,
    "max_wait_ms": 10.0
  },
  "kv_scheduler": {
    "policy": "slo_slack",
    "max_block_bytes": 65536,
    "max_concurrent_transfers": 16,
    "max_inflight_bytes": 1048576,
    "safety_margin_fraction": 0.1,
    "max_resource_inflight_bytes": 131072,
    "collective_guard_us": 10,
    "control_interval_us": 25,
    "queue_target_bytes": 65536
