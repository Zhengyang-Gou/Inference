  "feedback": {
    "time_authority": "ns3",
    "network_backend": "ns3_alibabacloud",
    "compute_backend": "profiling",
    "compute_profile_path": "../backend/fixtures/layered_compute_profile.json",
    "compute_profile_excludes_communication": true,
    "observation_delay_us": 10,
    "scheduling_overhead_us": 5,
    "network_observation_enabled": true,
    "network_observation_interval_us": 50,
    "network_ewma_alpha": 0.3
  },
  "reservations": {
    "reserve_max_output_tokens": 1024,
    "capacity_safety_fraction": 0.05,
    "shared_prefix_accounting": "physical_object",
    "source_release": "after_dependencies"
  },
  "evaluation": {
    "window_start_seconds": 0.0,
    "window_end_seconds": 0.1,
    "time_bin_seconds": 0.01,
