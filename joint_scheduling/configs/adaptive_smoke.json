    "output_dir": "../artifacts/evaluation",
    "plot_formats": [
      "png",
      "pdf"
    ],
    "plot_dpi": 160,
    "charts": [
      "latency_cdf",
      "latency_percentiles",
      "slo_throughput",
      "throughput_timeseries"
    ]
  },
  "runtime": {
    "seed": 7,
    "workload_path": "../backend/fixtures/staggered_slo_workload.json",
    "time_limit_seconds": 0.1,
    "congestion_control": "dcqcn",
    "packet_payload_bytes": 1000,
    "switch_buffer_bytes": 16777216,
    "rpc_timeout_seconds": 60.0,
    "kv_transfer_mode": "layer_ready_slo"
